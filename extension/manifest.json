{
  "manifest_version": 2,
  "name": "Langtitles",
  "version": "0.6.1",
  "description": "Langtitles: learn languages from what you watch. Word-by-word subtitle breakdowns with furigana and pinyin, grammar guides, a word bank, and subtitles fetched for the episode, on any streaming site. Powered by Claude with your own API key.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "langtitles@langtitles.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "<all_urls>",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "unlimitedStorage",
    "menus",
    "downloads"
  ],
  "background": {
    "scripts": [
      "vendor/anthropic-sdk.js",
      "shared/settings.js",
      "shared/subtitles.js",
      "shared/lang.js",
      "shared/grammar-ids.js",
      "background/prompt.js",
      "background/cache.js",
      "background/claude.js",
      "background/sniffer.js",
      "shared/episode.js",
      "background/files.js",
      "background/providers.js",
      "shared/strokes.js",
      "shared/srs.js",
      "shared/pitch.js",
      "shared/backup.js",
      "background/autobackup.js",
      "shared/guidetext.js",
      "background/libraryfixes.js",
      "background/shows.js",
      "shared/deinflect.js",
      "background/dict.js",
      "shared/lyrics.js",
      "background/music.js",
      "background/episodes.js",
      "background/main.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "content/early.js"
      ],
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "css": [
        "fonts/rounded/rounded.css",
        "fonts/geist/geist.css",
        "content/page.css"
      ],
      "js": [
        "shared/settings.js",
        "shared/subtitles.js",
        "shared/lang.js",
        "shared/guide.js",
        "shared/episode.js",
        "shared/sync.js",
        "shared/ruby.js",
        "shared/srs.js",
        "shared/strokes.js",
        "shared/speech.js",
        "shared/pitch.js",
        "shared/grammar-ids.js",
        "shared/hardsubs.js",
        "shared/icons.js",
        "shared/lyrics.js",
        "content/listen.js",
        "content/content.js"
      ]
    }
  ],
  "browser_action": {
    "default_title": "Langtitles",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "content/content.css",
    "data/grammar/*",
    "data/jlpt.json",
    "fonts/geist/*",
    "fonts/rounded/*",
    "icons/icon.svg"
  ],
  "commands": {
    "toggle-langtitles": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Turn Langtitles off or on everywhere"
    }
  }
}
